# =====================================================================
#  Superchat - OWNER credentials.   NEVER COMMIT OR SHARE THIS FILE.
#  It is git-ignored. Only the project owner needs it, and only for
#  `superchat admin init`. Employees never see or need these values.
# =====================================================================

# --- 1. The team's Supabase project ------------------------------------
SUPERCHAT_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key: Supabase > Project Settings > API Keys (starts with sb_publishable_).
# Not a secret. It is put into the repo's defaults so employees need nothing but their email.
SUPERCHAT_SUPABASE_KEY=

# --- 2. The database (Session pooler: works on IPv4 networks) ------------
# Supabase > Connect > Session pooler. The password is the DATABASE password
# (Project Settings > Database > Reset database password), not an API key.
PGHOST=aws-0-YOUR-REGION.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.YOUR-PROJECT-REF
PGPASSWORD=

# --- 3. You ---------------------------------------------------------------
# The email you sign in with; becomes the first admin.
SUPERCHAT_ADMIN_EMAIL=
